# Copie para .env (nunca commitar). Ambiente: development | staging | production
APP_ENV=development
APP_NAME=gemeo-digital-moto-renow
DEBUG=true

# Banco SaaS — local SQLite; produção use PostgreSQL
DATABASE_URL=sqlite:///data/saas.db
# DATABASE_URL=postgresql+psycopg2://saas:saas_secret@postgres:5432/gemeo_digital

# Supabase (auth e dados de motores — app existente)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — sem chaves no código; uma ou várias variáveis
GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
GEMINI_MODEL_DEFAULT=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite
GEMINI_MAX_CALLS_PER_KEY_PER_RUN=0

# Auth SaaS local (Docker / demo sem Supabase)
SAAS_STREAMLIT_AUTH_ENABLED=false
AUTH_CREDENTIALS_PATH=config/auth_credentials.yaml
AUTH_COOKIE_KEY=troque_esta_chave_secreta_em_producao

# Logs
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON=false
LOG_AUDIT_CALCULATIONS=true
