# Copie para config/auth_credentials.yaml (gitignored em produção).
# Gere hashes bcrypt: python -c "import streamlit_authenticator as st; print(st.Hasher(['sua_senha']).generate()[0])"
credentials:
  usernames:
    demo:
      email: demo@oficina.local
      name: Oficina Demo
      password: $2b$12$COLOQUE_HASH_BCRYPT_AQUI
cookie:
  expiry_days: 7
  key: mrw_saas_cookie
  name: mrw_saas_auth
preauthorized:
  emails:
    - demo@oficina.local
