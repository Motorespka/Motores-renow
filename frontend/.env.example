# Substitua pelos valores do projecto Supabase. Se deixar YOUR_* o site trata como sem Supabase (login teste admin/admin em dev).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Opcional: forcar login de demo admin/admin fora de `next dev` (ex.: next start local)
# NEXT_PUBLIC_DEV_DEMO_LOGIN=true

# Opcional: número comercial E.164 (apenas dígitos após +) para botões WhatsApp nas páginas de marketing
# Ex.: +351912345678 -> NEXT_PUBLIC_SALES_WHATSAPP_E164=351912345678
NEXT_PUBLIC_SALES_WHATSAPP_E164=
