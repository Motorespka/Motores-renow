APP_ENV=dev
APP_DEBUG=true
API_PREFIX=/api

# Porta do uvicorn (só scripts locais). Se no Windows aparecer WinError 10013 na 8000,
# ponha por exemplo 8010 e use a mesma no frontend: NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8010/api
BACKEND_PORT=8000

BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# URL do site Next.js no browser (redireciona /dashboard e /login se abrires na porta 8000)
FRONTEND_PUBLIC_URL=http://localhost:3000

DEFAULT_PAID_PLANS=paid,pro,premium,enterprise,business
SUPABASE_MOTORES_BUCKET=motores-imagens

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# ... ou GEMINI_KEY_01 .. GEMINI_KEY_14 (round-robin via config/api_manager.py)
GEMINI_MODEL=gemini-2.5-flash

CADASTRO_MAX_FILES=5
CADASTRO_MAX_FILE_SIZE_MB=12
CADASTRO_MAX_TOTAL_SIZE_MB=40
